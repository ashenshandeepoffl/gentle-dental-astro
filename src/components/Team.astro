---
// src/components/Team.astro
---

<section class="py-24 bg-white" id="team">
    <div class="max-w-7xl mx-auto px-6">
        
        <div class="text-center mb-16 md:mb-20">
            <h2 class="text-4xl md:text-5xl lg:text-6xl font-light text-brand-dark mb-4 tracking-tight">
                Meet the <span class="text-brand-primary font-medium">Gentle Dental</span> team
            </h2>
            <p class="text-gray-500 text-lg max-w-2xl mx-auto">
                Dedicated professionals committed to making your dental
                experience comfortable, anxiety-free, and personalized.
            </p>
        </div>

        <div class="flex flex-col gap-8 mb-12">
            
            <div class="bg-brand-light/40 rounded-[32px] md:rounded-[40px] p-8 md:p-12 lg:p-16 shadow-sm border border-brand-light flex flex-col lg:flex-row gap-10 lg:gap-16 items-center hover:shadow-md transition-shadow duration-300">
                <!-- Added oncontextmenu to the wrapper to disable right click on the entire circle -->
                <div class="w-56 h-56 md:w-72 md:h-72 lg:w-80 lg:h-80 shrink-0 relative group" oncontextmenu="return false;">
                    <div class="absolute inset-0 bg-brand-primary/10 rounded-full transform translate-x-3 translate-y-3 transition-transform group-hover:translate-x-4 group-hover:translate-y-4"></div>
                    <img
                        src="/Team/DrGayali.png"
                        alt="Dr. Gayali Mudalige"
                        draggable="false"
                        class="w-full h-full object-cover rounded-full relative z-10 border-4 border-white shadow-soft group-hover:scale-[1.02] transition-transform duration-500 pointer-events-none select-none"
                    />
                </div>

                <div class="flex-1 text-center lg:text-left">
                    <div class="inline-block bg-brand-light text-brand-primary font-medium px-5 py-2 rounded-full mb-4">
                        Principal Dentist • 30+ Years Experience
                    </div>
                    <h3 class="text-3xl md:text-4xl font-bold text-brand-dark mb-6">
                        Dr. Gayali Mudalige
                    </h3>

                    <div class="grid md:grid-cols-2 gap-8 text-left">
                        <div>
                            <h4 class="text-brand-primary font-semibold mb-3 flex items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
                                Qualifications
                            </h4>
                            <ul class="space-y-2 text-gray-600 text-sm leading-relaxed">
                                <li class="flex items-start gap-2">
                                    <span class="text-brand-primary mt-1">•</span> Bachelor of Dental Surgery (BDS)
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-brand-primary mt-1">•</span> Diploma in Hospital Dental Practice
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-brand-primary mt-1">•</span> Grad. Certificate in Clinical Dentistry
                                </li>
                            </ul>
                        </div>
                        <div>
                            <h4 class="text-brand-primary font-semibold mb-3 flex items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                                Specialties
                            </h4>
                            <p class="text-gray-600 text-sm leading-relaxed">
                                Known for an incredibly gentle touch. Specializes in
                                working with nervous patients, comprehensive family
                                dentistry, and pediatric care.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-brand-light/40 rounded-[32px] md:rounded-[40px] p-8 md:p-12 lg:p-16 shadow-sm border border-brand-light flex flex-col lg:flex-row gap-10 lg:gap-16 items-center hover:shadow-md transition-shadow duration-300">
                <div class="w-56 h-56 md:w-72 md:h-72 lg:w-80 lg:h-80 shrink-0 relative group" oncontextmenu="return false;">
                    <div class="absolute inset-0 bg-brand-primary/10 rounded-full transform translate-x-3 translate-y-3 transition-transform group-hover:translate-x-4 group-hover:translate-y-4"></div>
                    <img
                        src="/Team/DrLindsay.png"
                        alt="Dr. Lindsay Dyson"
                        draggable="false"
                        class="w-full h-full object-cover rounded-full relative z-10 border-4 border-white shadow-soft group-hover:scale-[1.02] transition-transform duration-500 pointer-events-none select-none"
                    />
                </div>

                <div class="flex-1 text-center lg:text-left">
                    <div class="inline-block bg-brand-light text-brand-primary font-medium px-5 py-2 rounded-full mb-4">
                        Clinic Mentor • 50+ Years Experience
                    </div>
                    <h3 class="text-3xl md:text-4xl font-bold text-brand-dark mb-6">
                        Dr. Lindsay Dyson
                    </h3>

                    <div class="grid md:grid-cols-2 gap-8 text-left">
                        <div>
                            <h4 class="text-brand-primary font-semibold mb-3 flex items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
                                Clinical Background
                            </h4>
                            <p class="text-gray-600 text-sm leading-relaxed mb-3">
                                B.D.S. (Adel.) F.I.C.C.D.E. Graduated from the University of Adelaide before practicing in Melbourne for over 30 years. Former University Tutor in restorative and conservative dentistry.
                            </p>
                            <ul class="space-y-1 text-gray-600 text-sm leading-relaxed">
                                <li class="flex items-start gap-2">
                                    <span class="text-brand-primary mt-1">•</span> Advanced Dento-facial Orthodontics (POS)
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-brand-primary mt-1">•</span> Certified Diode Laser practitioner
                                </li>
                            </ul>
                        </div>
                        <div>
                            <h4 class="text-brand-primary font-semibold mb-3 flex items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                                Beyond Dentistry
                            </h4>
                            <p class="text-gray-600 text-sm leading-relaxed">
                                A warm-hearted individual intent on passing on his experiences to others. In his private life, Lindsay is a bronze-medal winning skeet shooter and a dedicated Weimaraner gundog enthusiast, breeder, and published author.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            
            <div class="bg-white rounded-[32px] p-8 md:p-10 shadow-sm border border-gray-50 flex flex-col items-center text-center hover:-translate-y-2 hover:shadow-xl transition-all duration-300 group">
                <div class="w-32 h-32 rounded-full overflow-hidden mb-6 border-4 border-brand-light group-hover:border-brand-primary/20 transition-colors" oncontextmenu="return false;">
                    <!-- Note the addition of object-top here to bring the face down -->
                    <img
                        src="/Team/Marlie.png"
                        alt="Marlie H."
                        draggable="false"
                        class="w-full h-full object-cover object-top group-hover:scale-110 transition-transform duration-500 pointer-events-none select-none"
                    />
                </div>
                <div class="bg-brand-light text-brand-primary text-xs font-medium px-4 py-1.5 rounded-full mb-4">
                    Practice & Treatment Coordinator
                </div>
                <h3 class="text-2xl font-bold text-brand-dark mb-4">
                    Marlie
                </h3>
                <p class="text-gray-500 text-sm leading-relaxed max-w-sm">
                    Marlie has been with the practice for over ten years,
                    becoming a guiding influence. Outside of dental nursing, she
                    is a Cross-fit enthusiast and a former premiership-winning
                    basketball player.
                </p>
            </div>

            <div class="bg-white rounded-[32px] p-8 md:p-10 shadow-sm border border-gray-50 flex flex-col items-center text-center hover:-translate-y-2 hover:shadow-xl transition-all duration-300 group">
                <div class="w-32 h-32 rounded-full overflow-hidden mb-6 border-4 border-brand-light group-hover:border-brand-primary/20 transition-colors" oncontextmenu="return false;">
                    <img
                        src="/Team/Nisansala.png"
                        alt="Nisansala"
                        draggable="false"
                        class="w-full h-full object-cover object-top group-hover:scale-110 transition-transform duration-500 pointer-events-none select-none"
                    />
                </div>
                <div class="bg-brand-light text-brand-primary text-xs font-medium px-4 py-1.5 rounded-full mb-4">
                    Reception & Dental Assistant
                </div>
                <h3 class="text-2xl font-bold text-brand-dark mb-4">Nisansala</h3>
                <p class="text-gray-500 text-sm leading-relaxed max-w-sm">
                    A welcoming face at Gentle Dental, Nisansala ensures every patient's visit starts and ends with a smile. She assists our dentists and helps keep the clinic running smoothly.
                </p>
            </div>

            <div class="bg-white rounded-[32px] p-8 md:p-10 shadow-sm border border-gray-50 flex flex-col items-center text-center hover:-translate-y-2 hover:shadow-xl transition-all duration-300 group">
                <div class="w-32 h-32 rounded-full overflow-hidden mb-6 border-4 border-brand-light group-hover:border-brand-primary/20 transition-colors" oncontextmenu="return false;">
                    <img
                        src="/Team/Amy.png"
                        alt="Amy S."
                        draggable="false"
                        class="w-full h-full object-cover object-top group-hover:scale-110 transition-transform duration-500 pointer-events-none select-none"
                    />
                </div>
                <div class="bg-brand-light text-brand-primary text-xs font-medium px-4 py-1.5 rounded-full mb-4">
                    Reception & Dental Assistant
                </div>
                <h3 class="text-2xl font-bold text-brand-dark mb-4">Amy</h3>
                <p class="text-gray-500 text-sm leading-relaxed max-w-sm">
                    A cheerful recent addition to the team, showing a keen
                    interest in all her dental training. She is also a trainer
                    with the Vermont Junior Football Club and an avid netball
                    player.
                </p>
            </div>

        </div>
    </div>
</section>